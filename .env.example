# Copy to .env.local. All config lives here — the code has no hardcoded fallbacks.
# Variables marked (required) throw a clear error when missing.

# (required) Public base URL used for canonical URLs, Open Graph, sitemap and robots.
# Vercel preview deployments are automatically marked noindex.
NEXT_PUBLIC_SITE_URL=

# (required) CoinGecko REST API base URL.
COINGECKO_API_BASE_URL=

# (optional) Free CoinGecko "Demo" API key (raises the public rate limit). Server-only — never exposed to the browser.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# (required) Binance public market-data WebSocket.
NEXT_PUBLIC_BINANCE_WS_URL=

# (optional) Search engine ownership verification (meta tag content values only).
# Google Search Console → "HTML tag" method; Bing Webmaster Tools → "Meta tag" method.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
