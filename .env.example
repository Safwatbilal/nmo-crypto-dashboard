# All variables are optional — the app runs with none of them set.

# Public base URL used for canonical URLs, Open Graph, sitemap and robots.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=

# Free CoinGecko "Demo" API key (raises the public rate limit). Server-only — never exposed to the browser.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Override the CoinGecko base URL (default: https://api.coingecko.com/api/v3)
COINGECKO_API_BASE_URL=

# Binance public market-data WebSocket (default: wss://data-stream.binance.vision/ws)
NEXT_PUBLIC_BINANCE_WS_URL=
